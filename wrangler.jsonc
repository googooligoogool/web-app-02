{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-app-02",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "004497f4-20d1-46a6-abf5-36fa5423166c","database_name": "web-app-02" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "c9c7c2bcc0d54545a34912b8d9f3746e" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
